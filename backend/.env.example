# Copy to backend/.env for local development. Never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql://lifeos:lifeos@localhost:55432/lifeos
REDIS_URL=redis://localhost:56379/0
JWT_PRIVATE_KEY=dev-only-private-key
JWT_PUBLIC_KEY=dev-only-public-key
HMAC_KEY=dev-only-hmac-key
ENCRYPTION_KEY=dev-only-encryption-key
# Optional in development/test; required in staging/production
OPENAI_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
